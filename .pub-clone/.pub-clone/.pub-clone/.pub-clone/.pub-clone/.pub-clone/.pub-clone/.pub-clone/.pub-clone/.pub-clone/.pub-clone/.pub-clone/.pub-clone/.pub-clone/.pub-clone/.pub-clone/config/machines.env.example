# ASTRO — adresy maszyn treningowych / nauczycieli.
# Edytuj przy zmianie sieci. Wszystkie wartości można nadpisać zmiennymi środowiska.
#
# Kali (KALIBARA): źródłem prawdy jest /etc/atena-pc-link.env (PC_SSH) — ten sam host
# jest celem tunelu atena-pc-tunnel (127.0.0.1:11435 -> Kali:11434).
if [ -r /etc/atena-pc-link.env ]; then . /etc/atena-pc-link.env; fi
KALI_HOST="${KALI_HOST:-${PC_SSH:-user@192.168.0.2}}"
KALI_PASS_FILE="${KALI_PASS_FILE:-$HOME/.ssh/astro_pc.pass}"
# Trening LoRA na Kali: WYŁĄCZONY od 2026-09-26 (decyzja użytkownika). Dorobek z Kali przenoszony
# na Pi (scripts/pull_kali_archive.sh); aktywny model narzędzi pozostaje astro-qwen3-lora-v7.
# 0 = nie uruchamiaj pętli treningu na Kali (train_pcs_loop.sh wychodzi od razu).
KALI_TRAIN_ENABLED="${KALI_TRAIN_ENABLED:-0}"

# PC-MAX (Windows 11, nauczyciel mocny) i PC-2 (Windows 11, laptop) — OFFLINE od 2026-09-22
# (decyzja użytkownika: pomijamy do wyraźnego „włącz PC-MAX/PC-2"). Flagi 0/1 sterują pętlami
# i zbiórką: 0 = pomiń maszynę całkowicie (bez SSH, bez endpointów, bez tuneli).
PC_MAX_ENABLED="${PC_MAX_ENABLED:-0}"
PC2_ENABLED="${PC2_ENABLED:-0}"
PC_MAX_HOST="${PC_MAX_HOST:-user@192.168.1.10}"
PC_MAX_PASS_FILE="${PC_MAX_PASS_FILE:-$HOME/.ssh/astro_pcmax.pass}"
PC2_HOST="${PC2_HOST:-Windows 11@192.168.1.11}"
PC2_PASS_FILE="${PC2_PASS_FILE:-$HOME/.ssh/astro_pc2.pass}"

# Pi4 „skynet" (192.168.0.4) — host kontenerów (WP/MySQL, docelowo serwisy FTP/WWW), zarządzany
# przez ASTRO. SSH na porcie 2222; STaŁY tunel: `astro-pi4-tunnel.service` (auto-restart, boot).
# Porty przez tunel (na Pi): 2200->2222 (SSH), 8080->80 (WWW), 2121->21 (FTP).
PI4_HOST="${PI4_HOST:-user@192.168.0.4}"
PI4_SSH_PORT="${PI4_SSH_PORT:-2222}"
PI4_PASS_FILE="${PI4_PASS_FILE:-$HOME/.ssh/astro_pi4.pass}"
PI4_LOCAL_SSH="${PI4_LOCAL_SSH:-127.0.0.1:2200}"
PI4_LOCAL_WWW="${PI4_LOCAL_WWW:-127.0.0.1:8080}"
PI4_LOCAL_FTP="${PI4_LOCAL_FTP:-127.0.0.1:2121}"
PI4_ENABLED="${PI4_ENABLED:-1}"
